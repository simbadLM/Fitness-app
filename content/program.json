      "min": 10,
      "max": 45
    },
    "movementsPerSession": {
      "base": "1 mouvement par groupe musculaire (4 groupes), dans la phase courante du groupe",
      "focus": "1 à 2 mouvements supplémentaires sur le groupe 'focus' du jour",
      "total": "5 à 6 mouvements"
    },
    "phaseUpRuleOfThumb": "2 répétitions de plus sur la dernière série pendant 2 séances consécutives → suggérer le passage à la phase supérieure.",
    "improvementSignal": "10 à 20 % de répétitions totales en plus dans le même temps → durcir la séance.",
    "phaseUpCriteria": [
      "Toutes les répétitions terminées avec aisance",
      "Forme solide du début à la fin",
      "Récupération rapide",
      "Plus de courbatures/fatigue le lendemain",
      "Plus de challenge mental"
    ],
    "microProgressions": [
      "tempo (descente lente)",
      "pause reps",
      "poids (kettlebell, sac à dos)",
      "volume (séries/reps)",
      "amplitude"
    ],
    "phasesIndependentPerMuscleGroup": true,
    "exampleWeek": {
      "monday": "focus armsChest",
